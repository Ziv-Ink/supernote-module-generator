plugins {
  id("com.android.library")
  kotlin("android")
  id("com.google.devtools.ksp") version "2.0.21-1.0.28"
}

android {
  namespace = "$NAMESPACE"
  compileSdk = 35
  defaultConfig { minSdk = $MIN_SDK }
  compileOptions { sourceCompatibility = JavaVersion.VERSION_17; targetCompatibility = JavaVersion.VERSION_17 }
}

val reactNativeVersion: String =
  System.getenv("SUPERNOTE_REACT_NATIVE_VERSION")
    ?: run {
      val packageFile =
        rootProject.projectDir.parentFile.resolve(
          "node_modules/react-native/package.json",
        )
      require(packageFile.isFile) {
        "Cannot find the parent plugin's React Native package at $packageFile"
      }
      val packageJson =
        groovy.json.JsonSlurper().parseText(packageFile.readText()) as Map<*, *>
      packageJson["version"] as? String
        ?: error("React Native package.json has no version")
    }

dependencies {
  compileOnly("com.facebook.react:react-android:$reactNativeVersion")
  val annotationProject = rootProject.project(":$GRADLE_MODULE_NAME:native-annotation")
  val processorProject = rootProject.project(":$GRADLE_MODULE_NAME:native-processor")
  compileOnly(annotationProject)
  ksp(processorProject)
}

val supernoteTypescriptDeclarations = file("../index.d.ts")

ksp {
  arg("localModuleNamespace", "$NAMESPACE")
  arg("localModuleName", "$MODULE_NAME_RAW")
  arg("localPackageClass", "$CLASS_PREFIX")
  arg("localAnnotationName", "$ANNOTATION_FQCN")
  arg("localLegacyAnnotationName", "$LEGACY_ANNOTATION_FQCN")
  arg("localTypescriptOutput", supernoteTypescriptDeclarations.absolutePath)
}

tasks.matching { it.name.startsWith("ksp") }.configureEach {
  outputs.file(supernoteTypescriptDeclarations)
}

kotlin { jvmToolchain(17) }
