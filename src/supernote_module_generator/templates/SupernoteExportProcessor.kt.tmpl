package localmodule.processor

import com.google.devtools.ksp.getConstructors
import com.google.devtools.ksp.getVisibility
import com.google.devtools.ksp.processing.Dependencies
import com.google.devtools.ksp.processing.Resolver
import com.google.devtools.ksp.processing.SymbolProcessor
import com.google.devtools.ksp.processing.SymbolProcessorEnvironment
import com.google.devtools.ksp.processing.SymbolProcessorProvider
import com.google.devtools.ksp.symbol.ClassKind
import com.google.devtools.ksp.symbol.KSAnnotated
import com.google.devtools.ksp.symbol.KSClassDeclaration
import com.google.devtools.ksp.symbol.KSFunctionDeclaration
import com.google.devtools.ksp.symbol.KSNode
import com.google.devtools.ksp.symbol.Modifier
import com.google.devtools.ksp.symbol.Origin
import com.google.devtools.ksp.symbol.Visibility
import com.google.devtools.ksp.validate
import java.io.File
import java.io.OutputStreamWriter

private val supported = setOf("kotlin.Boolean", "kotlin.Double", "kotlin.String")
private val typescriptReserved = setOf(
  "await", "break", "case", "catch", "class", "const", "continue",
  "debugger", "default", "delete", "do", "else", "enum", "export",
  "extends", "false", "finally", "for", "function", "if", "implements",
  "import", "in", "instanceof", "interface", "let", "new", "null",
  "package", "private", "protected", "public", "return", "static",
  "super", "switch", "this", "throw", "true", "try", "typeof", "var",
  "void", "while", "with", "yield",
)
private val kotlinKeywords = typescriptReserved + setOf(
  "as", "fun", "is", "object", "typealias", "val", "var", "when",
)
private val generatedMethodNames = setOf(
  "canOverrideExistingModule",
  "getConstants",
  "getName",
  "hasConstants",
  "initialize",
  "invalidate",
  "onCatalystInstanceDestroy",
)

class SupernoteExportProcessor(
  private val environment: SymbolProcessorEnvironment,
) : SymbolProcessor {
  private var generated = false

  override fun process(resolver: Resolver): List<KSAnnotated> {
    if (generated) return emptyList()
    val annotationName =
      environment.options["localAnnotationName"]
        ?: error("Missing KSP option localAnnotationName")
    val legacyAnnotationName =
      environment.options["localLegacyAnnotationName"].orEmpty()
    val annotationNames =
      listOf(annotationName, legacyAnnotationName).filter { it.isNotEmpty() }.toSet()

    val symbolsByLocation = linkedMapOf<String, KSAnnotated>()
    annotationNames.forEach { name ->
      resolver.getSymbolsWithAnnotation(name).forEach { symbol ->
        val declaration = symbol as? KSFunctionDeclaration
        val key =
          "${declaration?.qualifiedName?.asString() ?: symbol::class.qualifiedName}" +
            "@${symbol.location}"
        symbolsByLocation.putIfAbsent(key, symbol)
      }
    }
    val symbols = symbolsByLocation.values.toList()
    val invalid = symbols.filterNot { it.validate() }
    if (invalid.isNotEmpty()) return invalid

    val exports =
      symbols.map { symbol ->
        val function =
          symbol as? KSFunctionDeclaration
            ?: error(symbol, "@SupernotePluginExport may annotate only functions")
        validate(function, annotationNames)
      }.sortedWith(compareBy({ it.name }, { it.owner }))
    exports.groupBy { it.name }.filterValues { it.size > 1 }.forEach {
      (name, entries) ->
      error(
        entries.first().symbol,
        "duplicate JavaScript export name '$name'; use " +
          "@SupernotePluginExport(name = \"...\") to disambiguate",
      )
    }
    generate(exports)
    generated = true
    return emptyList()
  }

  private fun validate(
    function: KSFunctionDeclaration,
    annotationNames: Set<String>,
  ): Export {
    fun fail(message: String): Nothing = error(function, message)
    val parent =
      function.parentDeclaration as? KSClassDeclaration
        ?: fail(
          "@SupernotePluginExport functions must be members of a concrete public class",
        )
    if (
      parent.classKind != ClassKind.CLASS ||
        Modifier.ABSTRACT in parent.modifiers ||
        parent.getVisibility() != Visibility.PUBLIC
    ) {
      fail("${parent.simpleName.asString()} must be a concrete public class")
    }
    if (parent.typeParameters.isNotEmpty()) {
      fail("${parent.simpleName.asString()} may not be generic")
    }
    val nestedInClass = parent.parentDeclaration is KSClassDeclaration
    val javaStaticNested =
      parent.modifiers.any {
        it.name == "JAVA_STATIC" || it.name == "STATIC"
      }
    if (
      Modifier.INNER in parent.modifiers ||
        (nestedInClass && parent.origin == Origin.JAVA && !javaStaticNested)
    ) {
      fail(
        "${parent.simpleName.asString()} must not be an inner or non-static " +
          "member class; move it to top level or make it a static/nested class",
      )
    }
    val constructor = selectConstructor(parent, ::fail)

    if (
      function.getVisibility() != Visibility.PUBLIC ||
        Modifier.ABSTRACT in function.modifiers ||
        Modifier.SUSPEND in function.modifiers ||
        Modifier.INLINE in function.modifiers ||
        Modifier.OPERATOR in function.modifiers ||
        function.modifiers.any {
          it.name == "JAVA_STATIC" || it.name == "STATIC"
        }
    ) {
      fail(
        "${function.simpleName.asString()} must be a public, concrete instance " +
          "method; suspend, inline, operator, and static methods are unsupported",
      )
    }
    if (function.typeParameters.isNotEmpty() || function.extensionReceiver != null) {
      fail(
        "${function.simpleName.asString()} may not be generic or an extension function",
      )
    }
    val parameters =
      function.parameters.mapIndexed { index, parameter ->
        if (parameter.isVararg) {
          fail("${function.simpleName.asString()} may not use vararg")
        }
        val type = parameter.type.resolve()
        val typeName = normalize(type.declaration.qualifiedName?.asString())
        if (type.isMarkedNullable || typeName !in supported) {
          fail(
            "${function.simpleName.asString()} parameter " +
              "'${parameter.name?.asString()}' has unsupported type " +
              "${type.declaration.qualifiedName?.asString()}; supported " +
              "parameters: Boolean, Double, String",
          )
        }
        val sourceName = parameter.name?.asString().orEmpty()
        val declarationName =
          if (
            Regex("^[A-Za-z_][A-Za-z0-9_]*$").matches(sourceName) &&
              sourceName !in typescriptReserved
          ) {
            sourceName
          } else {
            "arg$index"
          }
        ExportParameter(declarationName, typeName!!)
      }
    val returned =
      function.returnType?.resolve()
        ?: fail("${function.simpleName.asString()} must declare a return type")
    val returnName = normalize(returned.declaration.qualifiedName?.asString())
    if (
      returned.isMarkedNullable ||
        (returnName != "kotlin.Unit" && returnName !in supported)
    ) {
      fail(
        "${function.simpleName.asString()} has unsupported return type " +
          "$returnName; supported returns: Unit, Boolean, Double, String",
      )
    }

    val annotations =
      function.annotations.filter {
        it.annotationType.resolve().declaration.qualifiedName?.asString() in
          annotationNames
      }.toList()
    if (annotations.size != 1) {
      fail(
        "apply exactly one export annotation; do not combine " +
          "@SupernotePluginExport with legacy @ReactNativeExport",
      )
    }
    val explicit =
      annotations.single().arguments
        .firstOrNull { it.name?.asString() == "name" }
        ?.value as? String ?: ""
    val name = explicit.ifEmpty { function.simpleName.asString() }
    if (!Regex("^[A-Za-z][A-Za-z0-9_]*$").matches(name)) {
      fail("export name '$name' is not JavaScript-safe")
    }
    if (name in generatedMethodNames) {
      fail(
        "export name '$name' conflicts with generated React Native module " +
          "infrastructure; choose another name with " +
          "@SupernotePluginExport(name = \"...\")",
      )
    }
    return Export(
      function,
      parent.qualifiedName!!.asString(),
      function.simpleName.asString(),
      name,
      parameters,
      returnName!!,
      constructor,
    )
  }

  private fun selectConstructor(
    owner: KSClassDeclaration,
    fail: (String) -> Nothing,
  ): ConstructorKind {
    val constructors = owner.getConstructors().toList()
    if (constructors.isEmpty()) return ConstructorKind.ZERO_ARGUMENT
    val publicConstructors =
      constructors.filter { it.getVisibility() == Visibility.PUBLIC }
    fun singleParameter(typeName: String): Boolean =
      publicConstructors.any { constructor ->
        constructor.parameters.size == 1 &&
          constructor.parameters.single().type.resolve()
            .declaration.qualifiedName?.asString() == typeName
      }
    return when {
      singleParameter("com.facebook.react.bridge.ReactApplicationContext") ->
        ConstructorKind.REACT_APPLICATION_CONTEXT
      singleParameter("android.content.Context") -> ConstructorKind.ANDROID_CONTEXT
      publicConstructors.any { it.parameters.isEmpty() } ->
        ConstructorKind.ZERO_ARGUMENT
      else ->
        fail(
          "${owner.simpleName.asString()} requires a public constructor taking " +
            "ReactApplicationContext, a public constructor taking Context, or " +
            "a public zero-argument constructor",
        )
    }
  }

  private fun generate(exports: List<Export>) {
    val namespace =
      environment.options["localModuleNamespace"]
        ?: error("Missing KSP option localModuleNamespace")
    val moduleName =
      environment.options["localModuleName"]
        ?: error("Missing KSP option localModuleName")
    val packageClass =
      environment.options["localPackageClass"]
        ?: error("Missing KSP option localPackageClass")
    val owners = exports.distinctBy { it.owner }
    val instances =
      owners.mapIndexed { index, export ->
        val argument =
          when (export.constructor) {
            ConstructorKind.REACT_APPLICATION_CONTEXT,
            ConstructorKind.ANDROID_CONTEXT -> "reactApplicationContext"
            ConstructorKind.ZERO_ARGUMENT -> ""
          }
        "  private val api$index by lazy { " +
          "${kotlinQualifiedIdentifier(export.owner)}($argument) }"
      }.joinToString("\n")
    val ownerIndex =
      owners.mapIndexed { index, export -> export.owner to index }.toMap()
    val methods =
      exports.joinToString("\n\n") { export ->
        val parameters =
          export.parameters.mapIndexed { index, parameter ->
            "arg$index: ${parameter.type.removePrefix("kotlin.")}"
          }.joinToString(", ")
        val arguments =
          export.parameters.indices.joinToString(", ") { "arg$it" }
        val call =
          "api${ownerIndex[export.owner]}." +
            "${kotlinIdentifier(export.kotlinName)}($arguments)"
        val generatedName = kotlinIdentifier(export.name)
        if (export.returnType == "kotlin.Unit") {
          val failureMessage =
            quote("Module $moduleName export '${export.name}' failed")
          """
  @ReactMethod
  fun $generatedName($parameters) {
    try {
      $call
    } catch (failure: Throwable) {
      Log.e(LOG_TAG, $failureMessage, failure)
    }
  }""".trimIndent()
        } else {
          """
  @ReactMethod
  fun $generatedName($parameters${if (parameters.isEmpty()) "" else ", "}promise: Promise) {
    try {
      val value: Any? = $call
      if (value == null) {
        throw IllegalStateException(
          "${export.name} returned null; native module values must be non-null",
        )
      }
      promise.resolve(value)
    } catch (failure: Throwable) {
      promise.reject("LOCAL_NATIVE_MODULE_ERROR", failure.message, failure)
    }
  }""".trimIndent()
        }
      }
    val text =
      """package $namespace.generated

import android.util.Log
import com.facebook.react.ReactPackage
import com.facebook.react.bridge.NativeModule
import com.facebook.react.bridge.Promise
import com.facebook.react.bridge.ReactApplicationContext
import com.facebook.react.bridge.ReactContextBaseJavaModule
import com.facebook.react.bridge.ReactMethod
import com.facebook.react.uimanager.ViewManager

class GeneratedNativeModule(
  context: ReactApplicationContext,
) : ReactContextBaseJavaModule(context) {
$instances
  override fun getName(): String = ${quote(moduleName)}

$methods

  private companion object {
    const val LOG_TAG = "Supernote$packageClass"
  }
}

class ${packageClass}NativeModulePackage : ReactPackage {
  override fun createNativeModules(
    context: ReactApplicationContext,
  ): List<NativeModule> = listOf(GeneratedNativeModule(context))

  override fun createViewManagers(
    context: ReactApplicationContext,
  ): List<ViewManager<*, *>> = emptyList()
}
"""
    val sourceFiles =
      exports.mapNotNull { it.symbol.containingFile }.distinct().toTypedArray()
    environment.codeGenerator
      .createNewFile(
        Dependencies(true, *sourceFiles),
        "$namespace.generated",
        "GeneratedNativeModule",
      ).use { output ->
        OutputStreamWriter(output).use { writer -> writer.write(text) }
      }
    generateTypescript(exports, moduleName)
  }

  private fun generateTypescript(exports: List<Export>, moduleName: String) {
    val output =
      environment.options["localTypescriptOutput"]
        ?: error("Missing KSP option localTypescriptOutput")
    val methods =
      exports.joinToString("\n") { export ->
        val parameters =
          export.parameters.joinToString(", ") { parameter ->
            "${parameter.name}: ${typescriptType(parameter.type)}"
          }
        val result =
          if (export.returnType == "kotlin.Unit") {
            "void"
          } else {
            "Promise<${typescriptType(export.returnType)}>"
          }
        "  ${export.name}($parameters): $result;"
      }
    val body = if (methods.isEmpty()) "" else "$methods\n"
    val text =
      "/* Generated by supernote_module_generator. Do not edit. */\n" +
        "export interface ${moduleName}Module {\n" +
        body +
        "}\n\n" +
        "declare const $moduleName: ${moduleName}Module;\n" +
        "export default $moduleName;\n"
    File(output).writeText(text, Charsets.UTF_8)
  }

  private fun typescriptType(type: String): String =
    when (type) {
      "kotlin.Boolean" -> "boolean"
      "kotlin.Double" -> "number"
      "kotlin.String" -> "string"
      else -> error("Unsupported generated TypeScript type $type")
    }

  private fun kotlinIdentifier(value: String): String =
    if (
      Regex("^[A-Za-z_][A-Za-z0-9_]*$").matches(value) &&
        value !in kotlinKeywords
    ) {
      value
    } else {
      "`$value`"
    }

  private fun kotlinQualifiedIdentifier(value: String): String =
    value.split(".").joinToString(".") { kotlinIdentifier(it) }

  private fun quote(value: String): String =
    "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\""

  private fun normalize(name: String?): String? =
    when (name) {
      "java.lang.String" -> "kotlin.String"
      "java.lang.Void" -> "kotlin.Unit"
      else -> name
    }

  private fun error(symbol: KSNode, message: String): Nothing {
    environment.logger.error("SupernotePluginExport: $message", symbol)
    throw IllegalArgumentException(message)
  }
}

private enum class ConstructorKind {
  REACT_APPLICATION_CONTEXT,
  ANDROID_CONTEXT,
  ZERO_ARGUMENT,
}

private data class ExportParameter(
  val name: String,
  val type: String,
)

private data class Export(
  val symbol: KSFunctionDeclaration,
  val owner: String,
  val kotlinName: String,
  val name: String,
  val parameters: List<ExportParameter>,
  val returnType: String,
  val constructor: ConstructorKind,
)

class SupernoteExportProcessorProvider : SymbolProcessorProvider {
  override fun create(
    environment: SymbolProcessorEnvironment,
  ): SymbolProcessor = SupernoteExportProcessor(environment)
}
