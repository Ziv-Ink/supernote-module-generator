package $NAMESPACE.generated

import android.util.Log
import com.facebook.react.ReactPackage
import com.facebook.react.bridge.NativeModule
import com.facebook.react.bridge.ReactApplicationContext
import com.facebook.react.bridge.ReactContextBaseJavaModule
import com.facebook.react.uimanager.ViewManager
import com.facebook.soloader.DirectorySoSource
import com.facebook.soloader.SoLoader
import dalvik.system.BaseDexClassLoader
import java.io.File

class ${CLASS_PREFIX}JsiModule(
    private val context: ReactApplicationContext,
) : ReactContextBaseJavaModule(context) {

  override fun getName(): String = "${CLASS_PREFIX}JsiInstaller"

  override fun initialize() {
    super.initialize()
    if (!loadNativeLibraryFromPluginHost()) {
      return
    }
    context.runOnJSQueueThread {
      val holder = context.javaScriptContextHolder
      if (holder == null) {
        Log.e(TAG, "JavaScriptContextHolder is null")
        return@runOnJSQueueThread
      }
      synchronized(holder) {
        val runtimePointer = holder.get()
        if (runtimePointer == 0L) {
          Log.e(TAG, "JSI runtime pointer is zero")
          return@synchronized
        }
        if (!nativeInstall(runtimePointer)) {
          Log.e(TAG, "C++ JSI installation failed")
        }
      }
    }
  }

  private fun loadNativeLibraryFromPluginHost(): Boolean {
    return try {
      val pluginClassLoader = ${CLASS_PREFIX}JsiModule::class.java.classLoader
      val libraryPath =
          (pluginClassLoader as? BaseDexClassLoader)
              ?.findLibrary("$NATIVE_LIBRARY_NAME")
              ?: error("Cannot find lib$NATIVE_LIBRARY_NAME.so")
      val libraryDirectory =
          File(libraryPath).parentFile
              ?: error("Cannot find native-library directory")
      val thread = Thread.currentThread()
      val previousClassLoader = thread.contextClassLoader
      try {
        thread.contextClassLoader = pluginClassLoader
        SoLoader.loadLibrary("jsi")
        if (SoLoader.getLibraryPath(System.mapLibraryName("$NATIVE_LIBRARY_NAME")) !=
            libraryPath) {
          SoLoader.prependSoSource(
              DirectorySoSource(
                  libraryDirectory,
                  DirectorySoSource.RESOLVE_DEPENDENCIES,
              ),
          )
        }
        SoLoader.loadLibrary("$NATIVE_LIBRARY_NAME")
      } finally {
        thread.contextClassLoader = previousClassLoader
      }
      Log.i(TAG, "Loaded $libraryPath through PluginHost")
      true
    } catch (failure: Throwable) {
      Log.e(TAG, "Cannot load JSI module through PluginHost", failure)
      false
    }
  }

  private external fun nativeInstall(runtimePointer: Long): Boolean

  private companion object {
    const val TAG = "$LOG_TAG"
  }
}

class ${CLASS_PREFIX}NativeModulePackage : ReactPackage {
  override fun createNativeModules(
      reactContext: ReactApplicationContext,
  ): List<NativeModule> = listOf(${CLASS_PREFIX}JsiModule(reactContext))

  override fun createViewManagers(
      reactContext: ReactApplicationContext,
  ): List<ViewManager<*, *>> = emptyList()
}
