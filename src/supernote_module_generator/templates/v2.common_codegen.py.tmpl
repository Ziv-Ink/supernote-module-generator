#!/usr/bin/env python3
"""Generated standalone V2 semantic merge stage. Do not edit."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import tempfile

from common_support.binding_codegen import (
    CodegenError,
    render_v2_feature_jsi,
    render_v2_plugin_jsi,
    scan_cpp_semantic_model,
)
from common_support.jvm_manifest import read_jvm_manifest
from common_support.jvm_projection import project_jvm_owners
from common_support.semantic import (
    SemanticApi,
    merge_semantic_apis,
    semantic_api_from_manifest,
)
from common_support.typescript_codegen import render_typescript


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--plugin-root", type=Path, required=True)
    parser.add_argument("--runtime-root", type=Path, required=True)
    parser.add_argument("--variant", required=True)
    arguments = parser.parse_args()
    generate(
        arguments.plugin_root.resolve(),
        arguments.runtime_root.resolve(),
        arguments.variant,
    )
    return 0


def generate(plugin_root: Path, runtime_root: Path, variant: str) -> None:
    registry = json.loads(
        (runtime_root / "feature-registry.json").read_text(encoding="utf-8")
    )
    if registry.get("generator_version") != "${GENERATOR_VERSION}":
        raise RuntimeError("generated runtime and common generator versions disagree")
    features = registry.get("features")
    if not isinstance(features, list):
        raise RuntimeError("feature registry has no feature list")
    manifest_root = (
        runtime_root
        / "build/generated/ksp"
        / variant
        / "resources/supernote/generated/manifests"
    )
    jvm_by_feature: dict[str, list[Path]] = {}
    if manifest_root.is_dir():
        for path in sorted(manifest_root.glob("*.json")):
            raw = json.loads(path.read_text(encoding="utf-8"))
            feature_id = raw.get("feature_id")
            if not isinstance(feature_id, str):
                raise RuntimeError(f"{path}: JVM manifest has no feature identity")
            jvm_by_feature.setdefault(feature_id, []).append(path)

    known = {item["feature_id"] for item in features}
    unknown = sorted(set(jvm_by_feature) - known)
    if unknown:
        raise RuntimeError("KSP emitted manifests for unknown features: " + ", ".join(unknown))

    output_root = runtime_root / "build/generated/supernote" / variant
    semantic_registry = []
    generated_jni: dict[str, str] = {}
    for feature in features:
        feature_id = feature["feature_id"]
        suffix = feature_id.removeprefix("supernote:feature:")
        cpp_raw = json.loads(
            (runtime_root / "inputs" / suffix / "cpp-semantic.json").read_text(
                encoding="utf-8"
            )
        )
        recorded_cpp = semantic_api_from_manifest(cpp_raw)
        feature_root = plugin_root / "local_modules" / feature["npm_name"]
        native_root = feature_root / feature["implementation_roots"]["native"]
        cpp = (
            scan_cpp_semantic_model(
                feature_root, module_name=feature["public_name"]
            )
            if native_root.is_dir()
            else SemanticApi()
        )
        if cpp.manifest() != recorded_cpp.manifest():
            raise RuntimeError(
                f"{feature_id}: recorded C++ semantics are stale; "
                "run supernote-module update before building"
            )
        manifests = jvm_by_feature.get(feature_id, [])
        if len(manifests) > 1:
            raise RuntimeError(f"multiple JVM manifests were emitted for {feature_id}")
        jvm = SemanticApi()
        if manifests:
            source_manifest = read_jvm_manifest(
                manifests[0], expected_feature_id=feature_id
            )
            jvm = project_jvm_owners(source_manifest.owners)
        if jvm.functions or jvm.classes:
            raise RuntimeError(
                f"{feature_id}: JVM declarations were recognized, but the "
                "typed JSI/JNI route is not implemented yet"
            )
        semantic = merge_semantic_apis(cpp, jvm)
        semantic_json = semantic.manifest()
        encoded = json.dumps(
            semantic_json, ensure_ascii=False, separators=(",", ":"), sort_keys=True
        ).encode("utf-8")
        semantic_registry.append(
            {
                "feature_id": feature_id,
                "semantic_digest": hashlib.sha256(encoded).hexdigest(),
                "semantic_api": semantic_json,
            }
        )
        _atomic_write(
            output_root / "semantics" / f"{suffix}.json",
            json.dumps(semantic_json, indent=2, sort_keys=True) + "\n",
        )
        _atomic_write(
            feature_root / "index.d.ts",
            render_typescript(feature["public_name"], semantic),
        )
        try:
            generated_jni[f"feature_{suffix}.cpp"] = render_v2_feature_jsi(
                feature_root,
                module_name=feature["public_name"],
                feature_id=feature_id,
            )
        except CodegenError as exc:
            raise RuntimeError(str(exc)) from exc
    generated_jni["plugin_bindings.cpp"] = render_v2_plugin_jsi(
        [feature["feature_id"] for feature in features]
    )
    jni_root = output_root / "jni"
    for name, source in generated_jni.items():
        _atomic_write(jni_root / name, source)
    if jni_root.is_dir():
        for stale in jni_root.glob("*.cpp"):
            if stale.name not in generated_jni:
                stale.unlink()
    _atomic_write(
        output_root / "semantic-registry.json",
        json.dumps(
            {
                "schema_version": 1,
                "generator_version": "${GENERATOR_VERSION}",
                "features": semantic_registry,
            },
            indent=2,
            sort_keys=True,
        )
        + "\n",
    )


def _atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.tmp-", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


if __name__ == "__main__":
    raise SystemExit(main())
