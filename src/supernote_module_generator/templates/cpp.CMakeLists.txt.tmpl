cmake_minimum_required(VERSION 3.22.1)

project($NATIVE_LIBRARY_NAME LANGUAGES C CXX)

set(CMAKE_C_STANDARD 23)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)
set(CMAKE_CXX_STANDARD 23)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

set(USER_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../src/main/cpp")
file(GLOB_RECURSE USER_C_SOURCES CONFIGURE_DEPENDS
  "${USER_SOURCE_ROOT}/*.c")
file(GLOB_RECURSE USER_CXX_SOURCES CONFIGURE_DEPENDS
  "${USER_SOURCE_ROOT}/*.cc"
  "${USER_SOURCE_ROOT}/*.cpp"
  "${USER_SOURCE_ROOT}/*.cxx")

set(GENERATED_BINDINGS
  "${CMAKE_CURRENT_LIST_DIR}/../build/generated/supernote/jni/generated_bindings.cpp")

$JSI_FIND_PACKAGE

add_library(
  $NATIVE_LIBRARY_NAME
  SHARED
  ${USER_C_SOURCES}
  ${USER_CXX_SOURCES}
  ${GENERATED_BINDINGS}
)

target_include_directories(
  $NATIVE_LIBRARY_NAME
  PRIVATE
  "${USER_SOURCE_ROOT}"
)

target_compile_options(
  $NATIVE_LIBRARY_NAME
  PRIVATE
  -Wall
  -Wextra
  -Wpedantic
)

target_link_libraries(
  $NATIVE_LIBRARY_NAME
  PRIVATE
  $JSI_LINK_TARGET
  log
)
